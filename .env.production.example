# Production template for Hostinger (qrx-generator.omarkhaled.info). Copy to .env on the server and
# fill the empty values there. Never commit real secrets to this file.

APP_NAME=Qrx
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://qrx-generator.omarkhaled.info

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u952344267_qrx
DB_USERNAME=u952344267_qrx
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Nothing in the app is queued, and shared hosting can't keep a worker running.
QUEUE_CONNECTION=sync

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=support@omarkhaled.info
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="support@omarkhaled.info"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- Stripe (Laravel Cashier) -------------------------------------------------
# Live or test keys from the Stripe dashboard. Webhook endpoint:
# https://qrx-generator.omarkhaled.info/stripe/webhook (events: customer.subscription.created/updated/deleted,
# customer.updated, customer.deleted, invoice.payment_action_required, invoice.paid).
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
CASHIER_CURRENCY=usd
CASHIER_CURRENCY_LOCALE=en

# One recurring monthly price per paid plan (Stripe → Products). After changing them run
# `php artisan db:seed --class=PlanSeeder --force` (safe to re-run) and `php artisan optimize`.
# Keep distinct placeholders until then: stripe_price_id is unique, so empty values can't be seeded.
STRIPE_PRICE_STARTER=price_starter_placeholder
STRIPE_PRICE_BUSINESS=price_business_placeholder
STRIPE_PRICE_AGENCY=price_agency_placeholder

# --- Social login (optional) --------------------------------------------------
# Callback URLs: https://qrx-generator.omarkhaled.info/auth/google/callback
#                https://qrx-generator.omarkhaled.info/auth/facebook/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# --- Qrx -----------------------------------------------------------------------
# Only set this (CF-IPCountry) if the site sits behind Cloudflare. Without a proxy that sets
# it, visitors could send the header themselves and fake their country in the analytics.
QRX_COUNTRY_HEADER=
