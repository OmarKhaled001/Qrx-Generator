#!/usr/bin/env bash
# Runs the test suite in the PHP 8.5 + imagick + gd + intl image (docker/php-test),
# so PNG/EPS QR rendering is always exercised. Extra arguments go to `artisan test`.
#   docker build --build-arg PHP_VERSION=8.5 -t qrx-php85 docker/php-test
set -euo pipefail
cd "$(dirname "$0")/.."

exec docker run --rm \
    --user "$(id -u):$(id -g)" \
    -e COMPOSER_HOME=/tmp/composer \
    -v "$PWD":/app -w /app \
    qrx-php85 php artisan test "$@"
